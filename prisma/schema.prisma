generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ENUMS
// ========================================

enum Role {
  USER
  ADMIN
}

enum AccessType {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ========================================
// USER
// ========================================

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  emailVerified Boolean @default(false)
  googleId      String? @unique

  progress            UserProgress[]
  submissions         WritingSubmission[]
  subscriptions       Subscription[]
  payments            Payment[]
  blogLikes           BlogLike[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userProfile      UserProfile?
  skillProgresses  SkillProgress[]
  dailyActivities  DailyActivity[]
  studySessions    StudySession[]
  activityRecords  ActivityRecord[]
  userAchievements UserAchievement[]
}

// ========================================
// LEVEL
// ========================================

model Level {
  id    String @id @default(uuid())
  name  String @unique
  order Int    @unique

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// BOOK
// ========================================

model Book {
  id     String  @id @default(uuid())
  name   String
  author String?

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([levelId])
}

// ========================================
// CHAPTER
// ========================================

model Chapter {
  id         String     @id @default(uuid())
  title      String
  chapterNo  Int
  accessType AccessType @default(FREE)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  vocabularies       Vocabulary[]
  grammarTopics      GrammarTopic[]
  sentenceExercises  SentenceExercise[]
  writingTasks       WritingTask[]
  listeningExercises ListeningExercise[]
  progress           UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, chapterNo])
  @@index([bookId])
}

// ========================================
// VOCABULARY
// ========================================

model Vocabulary {
  id             String  @id @default(uuid())
  germanWord     String
  englishMeaning String
  article        String?
  plural         String?
  audioUrl       String?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

// ========================================
// GRAMMAR TOPIC
// ========================================

model GrammarTopic {
  id          String  @id @default(uuid())
  title       String
  explanation String
  videoUrl    String?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  questions GrammarQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

// ========================================
// GRAMMAR QUESTION
// ========================================

model GrammarQuestion {
  id          String  @id @default(uuid())
  question    String
  type        String
  answer      String
  options     Json?
  explanation String?

  grammarId String
  grammar   GrammarTopic @relation(fields: [grammarId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([grammarId])
}

// ========================================
// SENTENCE BUILDING
// ========================================

model SentenceExercise {
  id          String  @id @default(uuid())
  question    String
  words       Json
  answer      String
  explanation String?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

// ========================================
// SCHREIBEN TASK
// ========================================

model WritingTask {
  id          String @id @default(uuid())
  title       String
  instruction String
  minWords    Int?
  maxWords    Int?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  submissions WritingSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

// ========================================
// SCHREIBEN SUBMISSION
// ========================================

model WritingSubmission {
  id       String @id @default(uuid())
  answer   String
  score    Float?
  feedback Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   WritingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
}

// ========================================
// HÖREN / LISTENING
// ========================================

model ListeningExercise {
  id         String  @id @default(uuid())
  title      String
  audioUrl   String
  transcript String?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  tasks ListeningTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

// ========================================
// LISTENING TASK
// ========================================

model ListeningTask {
  id       String @id @default(uuid())
  taskNo   Int
  type     String
  question String

  options Json?
  answer  Json

  explanation String?

  listeningExerciseId String
  listeningExercise   ListeningExercise @relation(fields: [listeningExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listeningExerciseId, taskNo])
  @@index([listeningExerciseId])
}

// ========================================
// USER PROGRESS
// ========================================

model UserProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  vocabularyProgress Float @default(0)
  grammarProgress    Float @default(0)
  sentenceProgress   Float @default(0)
  writingProgress    Float @default(0)
  listeningProgress  Float @default(0)
  overallProgress    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

// ========================================
// SUBSCRIPTION
// ========================================

model Subscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status SubscriptionStatus @default(ACTIVE)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

// ========================================
// PAYMENT
// ========================================

model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  status PaymentStatus @default(PENDING)

  paymentMethod String?
  transactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ========================================
// BLOG
// ========================================

model Blog {
  id         String  @id @default(uuid())
  title      String
  slug       String  @unique
  excerpt    String?
  content    String
  coverImage String?
  published  Boolean @default(false)

  likes BlogLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ========================================
// BLOG LIKE
// ========================================

model BlogLike {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, blogId])
  @@index([blogId])
  @@index([userId])
}

// ========================================
// VISA CHECKLIST
// ========================================

model VisaCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  items VisaChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// VISA CHECKLIST ITEM
// ========================================

model VisaChecklistItem {
  id          String  @id @default(uuid())
  title       String
  description String?
  required    Boolean @default(true)
  order       Int

  categoryId String
  category   VisaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// ========================================
// AUSBILDUNG
// ========================================

model Ausbildung {
  id          String @id @default(uuid())
  name        String @unique
  slug        String @unique
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ========================================
// OUR SERVICES
// ========================================

model Service {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  imageUrl    String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

// ========================================
// EMAIL VERIFICATION TOKEN
// ========================================

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ========================================
// PASSWORD RESET TOKEN
// ========================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ========================================
// LOGIN ATTEMPT
// ========================================

model LoginAttempt {
  id String @id @default(uuid())

  email          String
  failedAttempts Int    @default(0)

  lockedUntil DateTime?

  lastAttemptAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@index([lockedUntil])
}

// ========================================
// USER PROFILE
// ========================================

enum LearningSkill {
  GRAMMAR
  SCHREIBEN
  LISTENING
  VOCABULARY
  SENTENCE_BUILDING
  SPRECHEN
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  avatar       String?
  currentLevel String?
  targetLevel  String?

  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  totalStudyMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillProgress {
  id     String        @id @default(uuid())
  userId String
  skill  LearningSkill

  completedTasks Int @default(0)
  totalTasks     Int @default(0)

  currentScore  Float @default(0)
  previousScore Float @default(0)

  totalStudyMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
}

model DailyActivity {
  id     String   @id @default(uuid())
  userId String
  date   DateTime

  completedTasks Int @default(0)
  studyMinutes   Int @default(0)

  grammarCompleted    Int @default(0)
  schreibenCompleted  Int @default(0)
  listeningCompleted  Int @default(0)
  vocabularyCompleted Int @default(0)
  sentenceCompleted   Int @default(0)
  sprechenCompleted   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model StudySession {
  id     String @id @default(uuid())
  userId String

  skill           LearningSkill?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int            @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model ActivityRecord {
  id     String @id @default(uuid())
  userId String

  skill        LearningSkill
  activityType String
  referenceId  String?

  score           Float?
  durationMinutes Int    @default(0)

  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([userId, skill])
}

model UserAchievement {
  id             String @id @default(uuid())
  userId         String
  achievementKey String

  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId])
}
